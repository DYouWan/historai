# 文本模型：在项目根目录编辑 llm-profiles.json，为每个档案填写 apiKeyEnv（环境变量名），
# 再在此文件中设置对应密钥。创作中心可在界面选择厂商与档案。
#
# DeepSeek 示例档案使用：
DEEPSEEK_API_KEY=

# 通义千问（DashScope）示例档案使用（qwen-plus / qwen-turbo 共用）：
DASHSCOPE_API_KEY=

# 可选：模型列表 JSON 的绝对路径（默认 ./llm-profiles.json）
# LLM_PROFILES_PATH=

# 文生图：在项目根目录编辑 media-profiles.json，为每个档案填写 apiKeyEnv；
# 创作中心选择「文生图档案」。按需填写下列变量（未用到的可留空）。

# 火山引擎方舟 API Key（如 Seedream 文生图）：
ARK_API_KEY=

# OpenAI（如 media-profiles 中选 DALL·E 3 文生图）：
OPENAI_API_KEY=

# 口播 TTS（POST /api/tts）：火山引擎豆包语音 HTTP 非流式
# 文档：https://www.volcengine.com/docs/6561/79820 · 参数说明：https://www.volcengine.com/docs/6561/79823
# 若报错 [resource_id=] requested resource not granted：见 FAQ https://www.volcengine.com/docs/6561/111522（核对控制台已开通语音合成、cluster 与控制台集群 ID 一致、音色授权）
# VOLCENGINE_TTS_ACCESS_TOKEN=
# VOLCENGINE_TTS_APP_ID=
# 可选：与控制台「语音合成」服务集群 ID 一致，常见 volcano_tts，少数 volcano_icl 等
# VOLCENGINE_TTS_CLUSTER=volcano_tts
# 可选：默认音色；HTTP 示例为 BV700_streaming（无 VC_ 前缀）；界面预设 VC_*_streaming 会在请求前自动去掉 VC_
# VOLCENGINE_TTS_VOICE_TYPE=BV700_streaming
# 可选：VOLCENGINE_TTS_URL=https://openspeech.bytedance.com/api/v1/tts

# 口播 TTS：讯飞在线语音合成（WebSocket 流式版）
# 文档：https://www.xfyun.cn/doc/tts/online_tts/API.html
# IFLYTEK_TTS_APP_ID=
# IFLYTEK_TTS_API_KEY=
# IFLYTEK_TTS_API_SECRET=
# 可选：IFLYTEK_TTS_VCN=xiaoyan

# 可选：媒体档案 JSON 的绝对路径（默认 ./media-profiles.json）
# MEDIA_PROFILES_PATH=

# 可选：LLM 调试写入项目根 logs/*.llm-read.md（可读 Markdown，不含密钥）；HISTORAI_LLM_LOG=0 关闭。
# HISTORAI_LLM_LOG=0
# HISTORAI_LLM_LOG_DIR=
