# 文本模型：在项目根目录编辑 llm-profiles.json，为每个档案填写 apiKeyEnv（环境变量名），
# 再在此文件中设置对应密钥。创作中心可在界面选择厂商与档案。
#
# DeepSeek 示例档案使用：
DEEPSEEK_API_KEY=

# 通义千问（DashScope）示例档案使用（qwen-plus / qwen-turbo 共用）：
DASHSCOPE_API_KEY=

# 可选：模型列表 JSON 的绝对路径（默认 ./llm-profiles.json）
# LLM_PROFILES_PATH=

# 文生图 / 图生视频：在项目根目录编辑 media-profiles.json，为每个档案填写 apiKeyEnv；
# 创作中心分别选择「文生图档案」「图生视频档案」。按需填写下列变量（未用到的可留空）。
#
# 阿里云 DashScope（如 Qwen-Image 2.0 文生图；可与上文通义文案共用同一密钥）：
# DASHSCOPE_API_KEY 已在上文

# 火山引擎方舟 API Key（Seedream 文生图、Seedance 图生视频等）：
ARK_API_KEY=

# HappyHorse 官方 API（图生视频）：
HAPPYHORSE_API_KEY=

# OpenAI（如 media-profiles 中选 DALL·E 3 文生图）：
OPENAI_API_KEY=

# 口播 TTS（POST /api/tts）：火山引擎豆包语音 HTTP 非流式
# 文档：https://www.volcengine.com/docs/6561/79820
# VOLCENGINE_TTS_ACCESS_TOKEN=
# VOLCENGINE_TTS_APP_ID=
# 可选：VOLCENGINE_TTS_CLUSTER=volcano_tts
# 可选：VOLCENGINE_TTS_VOICE_TYPE=BV700_streaming
# 可选：VOLCENGINE_TTS_URL=https://openspeech.bytedance.com/api/v1/tts

# 口播 TTS：讯飞在线语音合成（WebSocket 流式版）
# 文档：https://www.xfyun.cn/doc/tts/online_tts/API.html
# IFLYTEK_TTS_APP_ID=
# IFLYTEK_TTS_API_KEY=
# IFLYTEK_TTS_API_SECRET=
# 可选：IFLYTEK_TTS_VCN=xiaoyan

# 可选：媒体档案 JSON 的绝对路径（默认 ./media-profiles.json）
# MEDIA_PROFILES_PATH=

# 可选：LLM 调试写入项目根 logs/*.llm-read.md（可读 Markdown，不含密钥）；HISTORAI_LLM_LOG=0 关闭。
# HISTORAI_LLM_LOG=0
# HISTORAI_LLM_LOG_DIR=
